// ============================================================
//  EMPÍRICAMENTE — schema.prisma
//  PostgreSQL · incluye tienda + escuela online
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
//  AUTENTICACIÓN (NextAuth) — sin cambios de lógica
//  Los campos de token necesitan @db.Text en Postgres:
//  los tokens OAuth superan el límite de varchar por defecto.
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
//  USUARIO
//  Campos nuevos al final. Todos opcionales, así que los
//  usuarios que ya existen no se rompen.
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  isAdmin       Boolean   @default(false)

  // --- Escuela online ---
  whatsapp         String?
  aceptaWhatsapp   Boolean   @default(false)
  consentimientoEn DateTime? // cuándo aceptó (requisito Ley 1581 de 2012)
  pais             String?
  origen           String? // de qué video o campaña llegó (?origen=yt-clase-04)

  interesDisciplinaId String?
  interesDisciplina   Discipline? @relation("InteresDisciplina", fields: [interesDisciplinaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  progreso LessonProgress[]
  partidas GameResult[]

  @@index([interesDisciplinaId])
  @@index([whatsapp])
  @@index([createdAt])
}

// ============================================================
//  ESCUELA ONLINE
// ============================================================

/// Cada instrumento o disciplina que se enseña.
/// Los slugs deben coincidir con los de app/clases/page.tsx
model Discipline {
  id      String  @id @default(cuid())
  slug    String  @unique
  nombre  String
  familia String // Cuerdas · Percusión · Teclado · Fuelle · Voz
  logro   String  @db.Text
  orden   Int     @default(0)
  activa  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecciones   Lesson[]
  interesados User[]   @relation("InteresDisciplina")

  @@index([activa, orden])
}

/// Una clase individual. En la Fase 1 son 3 por disciplina, de 10 min.
model Lesson {
  id           String     @id @default(cuid())
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  orden       Int
  titulo      String
  descripcion String? @db.Text
  videoUrl    String? // YouTube "no listado", Vimeo o Mux
  duracionSeg Int     @default(600)
  esGratis    Boolean @default(true)
  publicada   Boolean @default(false) // se pone en true cuando el video ya está grabado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progreso LessonProgress[]

  @@unique([disciplineId, orden])
  @@index([disciplineId])
}

/// El corazón del muestreo de la Fase 3.
/// De aquí sale el dato que decide la disciplina ganadora:
/// qué porcentaje de registrados completa las 3 clases.
model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  lessonId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completada     Boolean   @default(false)
  completadaEn   DateTime?
  segundosVistos Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

/// Tabla lista para el minijuego "¿Qué nota soy?" (Fase 4).
/// Todavía no se usa: existe para no tener que migrar otra vez
/// cuando conectes el onComplete() que ya dejaste en el juego.
/// Si prefieres no tenerla aún, borra este bloque y el campo
/// `partidas` del modelo User.
model GameResult {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  juego       String // "que-nota-soy"
  instrumento String
  nivel       Int
  aciertos    Int
  intentos    Int
  rachaMax    Int
  precision   Float

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([juego, createdAt])
}

// ============================================================
//  TIENDA — igual que antes, solo con @db.Text donde hacía falta
// ============================================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  price       Int // en COP
  priceFrom   Boolean  @default(false)
  stock       Int      @default(0)
  imageUrl    String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("new") // new, read, resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
